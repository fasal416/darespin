rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is in the game
    function isPlayerInGame(gameCode) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/games/$(gameCode)).data.players.keys();
    }
    
    // Helper function to check if user is game admin
    function isGameAdmin(gameCode) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/games/$(gameCode)).data.admin == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Games collection
    match /games/{gameCode} {
      allow read: if isPlayerInGame(gameCode);
      
      allow create: if isAuthenticated() && 
                      request.resource.data.admin == request.auth.uid;
      
      allow update: if isPlayerInGame(gameCode) && (
        // Admin can start game and update game state
        (isGameAdmin(gameCode) && 
         request.resource.data.admin == resource.data.admin) ||
        
        // Players can join the game (add themselves to players)
        (resource.data.status == 'waiting' &&
         request.auth.uid in request.resource.data.players.keys() &&
         request.resource.data.players.size() <= 5) ||
        
        // Current dare player can mark as completed
        (resource.data.currentDare.playerId == request.auth.uid &&
         request.resource.data.currentDare.status == 'completed' &&
         resource.data.currentDare.status == 'active') ||
        
        // Players can vote (not voting on themselves, not voting twice)
        (resource.data.currentDare.status == 'voting' &&
         resource.data.currentDare.playerId != request.auth.uid &&
         !(request.auth.uid in resource.data.currentDare.votes.map(v => v.userId)))
      );
      
      allow delete: if isGameAdmin(gameCode);
    }
    
    // Dares collection - read only for authenticated users
    match /dares/{dareId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only through import, not from client
    }
  }
}